PORT=3000
PERSISTENCE_TYPE=memory
SQLITE_STORAGE=./data/lavadero.sqlite
# Notificador de eventos: console | file
NOTIFIER_TYPE=console
NOTIFIER_FILE_PATH=./logs/eventos.log
# --- Seguridad (JWT) ---
# Generá un secreto largo y aleatorio y pegalo SOLO en tu .env (nunca acá):
#   node -e "console.log(require('node:crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=1h
BCRYPT_ROUNDS=10
LOGIN_RATE_LIMIT_MAX=5
# Administrador inicial (se crea al arrancar si no existe)
ADMIN_EMAIL=admin@lavadero.com
ADMIN_PASSWORD=

# --- Calendario de feriados (Clase 12) ---
# argentinadatos (API real) | fake (sin red)
CALENDARIO_TYPE=argentinadatos
FERIADOS_API_URL=https://api.argentinadatos.com
EXTERNAL_TIMEOUT_MS=5000
EXTERNAL_CONCURRENCY=3
FAKE_LATENCY_MS=300